# logger
LOGGER_LEVEL = debug

# security
# 必填。JWT_SECRET 与 REFRESH_TOKEN_SECRET 必须是各自独立、至少 32 位的随机字符串。
# 生成示例：openssl rand -base64 48
# 缺失、空值、短于 32 位，或仍使用已知占位值时，进程会拒绝启动。
# 复制本文件为 .env.production 后再填写。不要把真实密钥提交到 git。
# 已经用历史默认密钥运行过的环境，在升级后必须轮换这两个值并重新签发登录态。
JWT_SECRET =
JWT_EXPIRE = 86400 # 单位秒
REFRESH_TOKEN_SECRET =
REFRESH_TOKEN_EXPIRE = 2592000

# Member sessions: required independent random secrets (at least 32 characters each).
# Do not reuse either admin secret or reuse the member access secret for refresh.
# MEMBER_REFRESH_TOKEN_SECRET keys the HMAC of opaque refresh tokens stored in the database.
MEMBER_JWT_SECRET =
MEMBER_JWT_EXPIRE = 900 # seconds
MEMBER_REFRESH_TOKEN_SECRET =
MEMBER_REFRESH_TOKEN_EXPIRE = 2592000 # seconds

# WeChat OAuth (disabled until the application has matching WeChat platform credentials).
# Use website + snsapi_login, or official_account + snsapi_base / snsapi_userinfo.
# APP_ID, scope and the full callback URL must match the selected WeChat application.
# The callback is GET /<GLOBAL_PREFIX>/member/auth/wechat/callback; use your actual prefix.
# It returns JSON: intent, trusted returnUrl, and binding or member access/refresh tokens.
# Configure a frontend callback URL instead if the frontend will submit code/state to that API.
# Provider access/refresh tokens are never stored. Keep the AppSecret private.
WECHAT_OAUTH_ENABLED = false
WECHAT_OAUTH_MODE = website
WECHAT_OAUTH_APP_ID =
WECHAT_OAUTH_APP_SECRET =
WECHAT_OAUTH_CALLBACK_URL =
WECHAT_OAUTH_SCOPE = snsapi_login
# Comma-separated exact origins (scheme/host/port only), no wildcard, slash or path.
WECHAT_OAUTH_RETURN_ORIGINS = https://member.example.com
WECHAT_OAUTH_STATE_TTL_SECONDS = 600 # 300-600 seconds; one use
WECHAT_OAUTH_HTTP_TIMEOUT_MS = 5000 # 1-5000 milliseconds per provider request

# WeChat mini-program (independent from OAuth; disabled until configured).
# Keep AppSecret server-side. Submit only wx.login() code to these POST endpoints:
# /<GLOBAL_PREFIX>/member/social/wechat-miniapp/bind (member authentication)
# /<GLOBAL_PREFIX>/member/auth/wechat-miniapp (bound-identity login; no registration).
# session_key is discarded. Redis stores only a tenant-scoped SHA-256 code hash.
# Replay reservations survive upstream/database failures; request a fresh wx.login() code.
WECHAT_MINIAPP_ENABLED = false
WECHAT_MINIAPP_APP_ID =
WECHAT_MINIAPP_APP_SECRET =
WECHAT_MINIAPP_CODE_TTL_SECONDS = 300 # 300-600 seconds; local replay reservation
WECHAT_MINIAPP_HTTP_TIMEOUT_MS = 5000 # 1-5000 milliseconds per code2Session request

# swagger
SWAGGER_ENABLE = true
SWAGGER_PATH = api-docs
SWAGGER_VERSION = 1.0
# 公开演示 API 源站。Swagger 文档：https://nest-admin-api.pages.dev/api-docs/
# 自建部署请改成自己的源站，不要带 /api-docs（路径由 SWAGGER_PATH 拼接）。
SWAGGER_SERVER_URL = https://nest-admin-api.pages.dev

# db
# 生产环境不要使用本文件里的数据库 / Redis 默认口令。
DB_HOST = host.docker.internal
DB_PORT = 13307
DB_DATABASE = nest_admin
DB_USERNAME = root
DB_PASSWORD = root
DB_SYNCHRONIZE = false
DB_LOGGING = ["error"]

# redis
REDIS_PORT = 6379
REDIS_HOST = host.docker.internal
REDIS_PASSWORD = 123456
REDIS_DB = 0

# smtp
SMTP_HOST =
SMTP_PORT = 465
SMTP_USER =
SMTP_PASS =

# 是否为演示模式。为 true 时会拦截除 GET 和登录接口以外的请求，返回 403「演示模式下不允许操作」。
# 自建生产环境要关闭演示模式，写成下面任一形式即可（大小写不敏感，等号两侧空格可有可无）：
#   IS_DEMO=false
#   IS_DEMO=0
#   IS_DEMO="false"
# 即使部署工具把引号留在值里（例如 docker run --env-file 得到的 "false"），也会关闭。
# 只有 true 或 1 会开启。未设置时默认关闭。
# 注意：进程里如果已经有 IS_DEMO（容器环境变量、PM2 旧环境），.env 文件不会覆盖它。
# 公开演示站保持 true；改完后需要让新值进入进程环境并重启。
IS_DEMO=true
